#!/usr/bin/env bash
# Bounded git diff: file stats first, then at most N lines of hunks.
# Usage: diff-summary [-n LINES] [git diff args...]    e.g. diff-summary main...HEAD -- src/
set -euo pipefail

max=200
if [[ "${1:-}" == "-n" ]]; then
  max="$2"
  shift 2
fi

git diff --stat "$@"
total=$(git diff "$@" | wc -l | tr -d ' ')
echo
git diff "$@" | head -n "$max"
if (( total > max )); then
  echo
  echo "[truncated: showing $max of $total diff lines. Narrow with: diff-summary <range> -- <path>]"
fi
